  "classification": {
    "zh": "总部直管销售提案；项目价格、数量、交付和回款为规划输入，非客户订单或实际业绩。",
    "en": "HQ-managed sales proposal. Prices, volumes, delivery and receipts are planning inputs, not customer orders or actual results."
  },
  "assumptions": [
    {
      "zh": "收入按计划验收与服务月份列示，签约、收入和回款分开。产品毛利仅扣直接交付成本，不等于经营净利润。",
      "en": "Plan revenue by acceptance / service months and distinguish bookings, revenue and receipts. Product margin deducts direct delivery only; it is not net profit."
    },
    {
      "zh": "基准、增长和延期路径供客户开发与总部资源安排使用，按季度滚动校准。",
      "en": "Use base, growth and delayed paths for account development and HQ resources; update quarterly."
    }
  ]
